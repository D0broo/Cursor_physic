# Ключ Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_api_key_here

# Модель Gemini (за замовчуванням gemini-2.5-pro).
# Інші варіанти: gemini-1.5-pro, gemini-2.0-flash тощо.
GEMINI_MODEL=gemini-3.1-pro

# Базовий шлях для деплою на GitHub Pages (лише для статичного експорту).
# Workflow у .github/workflows/nextjs.yml задає його автоматично (напр. /Cursor_physic).
# Локально залиш порожнім:
NEXT_PUBLIC_BASE_PATH=

# Позначка статичної версії (GitHub Pages): вимикає ШІ-чат і тести.
# Workflow задає її автоматично. Локально не задавай:
NEXT_PUBLIC_STATIC_ONLY=false
